# ===============================================================================
# Ignytion IO - CRUCIBLE CORE
# .gitignore for picorv32_rtl_to_gds
# ===============================================================================

# Simulation waveforms / logs
*.vcd
*.fst
*.fsdb
*.log
lint_report.txt
lint_stdout.tmp

# Synthesis / P&R / STA generated outputs
*.sdc
*.def
*.odb
*.spef
*.sdf
04_synthesis/*.json
04_synthesis/*.v
!04_synthesis/synth.tcl
!04_synthesis/gen_sdc.tcl

# GDS / layout outputs
*.gds
*.gds.gz
*.lef
*.mag
*.magic.rc

# Physical verification reports (generated)
11_physical_verification/results/*
!11_physical_verification/results/.gitkeep

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Crucible / igny local run state (not the tracked toml/lock)
.ignytion/
crucible/*.tmp

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp

# picorv32 flow outputs (everything `make` generates; `make clean` removes these too)
final_output/
*.out
*.ext
*.spice
*.tlef
00_lint/lint_report.txt
04_synthesis/_in.txt
04_synthesis/_out.txt
08_sta/timing_report*.txt
09_place_and_route/route_output.v
09_place_and_route/route.guide
09_place_and_route/route_drc.rpt
09_place_and_route/route_congestion.rpt
